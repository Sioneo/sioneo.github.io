{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Edge against localhost",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}"
        },
        {
            "name": "Launch Edge with Ignore Certificate Errors",
            "type": "msedge",
            "request": "launch",
            "url": "https://localhost:3000",
            "runtimeArgs": [
                "--ignore-certificate-errors"
            ]
        }
    ]
}