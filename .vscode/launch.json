{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试当前 HTML 文件",
            "type": "msedge",
            "request": "launch", 
            "file": "${file}",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "调试本地服务器",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5500",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "附加到 Edge 浏览器",
            "type": "msedge", 
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}"
        }
    ]
}